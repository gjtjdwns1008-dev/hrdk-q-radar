# 아래 항목을 레포 루트 local_run/local.env 에 채우기 (2026-10-13 열쇠 단일화 — 이 폴더에 .env 를 두지 않음, local.env 는 깃허브 절대 금지)
GOOGLE_SHEET_URL=구글시트_URL_또는_키            # 대장이 있는 스프레드시트
LAW_API_KEY=법제처_OC_키                     # run: 시행일자 판본 원문 재수집 (국내 IP 로컬에서 실행)
GEMINI_API_KEY=제미나이_키                   # run: 개정 프롬프트 분석
LLM_MODEL=gemini-3.8-flash                  # run: 분석 모델 (워크플로우 YAML 과 동일하게)
LLM_THINKING_LEVEL=medium                    # run: low | medium | high
WORKNET_ENABLED=0                           # run: 워크넷 미조회(OFF) — 대장에 "미조회(OFF)" 기록
# + 레포 루트 local_run/gcp-key.json (서비스 계정 키 파일) — 깃허브 절대 금지
